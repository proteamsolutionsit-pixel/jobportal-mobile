# JobPortal mobile — build configuration
#
# THIS FILE IS DOCUMENTATION, NOT A FILE THE APP READS.
#
# The values below are supplied at COMPILE TIME through --dart-define. Nothing is
# loaded from disk at runtime and no `.env` is bundled as an asset.
#
# The reason, since a bundled .env is the more usual answer: a .env shipped as a
# Flutter asset is readable by anyone who unzips the APK. For base URLs that is
# harmless -- they are not secret -- but a file called .env invites the next
# person to put something in it that is. --dart-define has no such invitation:
# there is no file in the bundle to find.
#
# NO SECRET BELONGS HERE REGARDLESS. This application has no API key, no client
# secret and no signing key. Its only credential is the session cookie the server
# issues, and that lives in Android Keystore / iOS Keychain -- see
# docs/decisions.md D-001.

# ---------------------------------------------------------------------------
# APP_ENV        development | staging | production
# API_BASE_URL   scheme + host of the API. No trailing slash.
# ---------------------------------------------------------------------------

APP_ENV=development
API_BASE_URL=http://127.0.0.1:8000

# Staging (UAT)
#   APP_ENV=staging
#   API_BASE_URL=https://projobs.proteam.co.in
#
# Production
#   APP_ENV=production
#   API_BASE_URL=https://jobsflood.com


# ---------------------------------------------------------------------------
# Build commands
# ---------------------------------------------------------------------------
#
# Development, against the local API. The dev stack must be up first:
#   MariaDB on port 3308 (NOT a Windows service -- start it by hand)
#   uvicorn on 127.0.0.1:8000
#
#   flutter run \
#     --dart-define=APP_ENV=development \
#     --dart-define=API_BASE_URL=http://127.0.0.1:8000
#
# An Android emulator cannot reach the host's 127.0.0.1. Use 10.0.2.2:
#   --dart-define=API_BASE_URL=http://10.0.2.2:8000
#
# Staging:
#   flutter build apk --release \
#     --dart-define=APP_ENV=staging \
#     --dart-define=API_BASE_URL=https://projobs.proteam.co.in
#
# Production:
#   flutter build appbundle --release \
#     --dart-define=APP_ENV=production \
#     --dart-define=API_BASE_URL=https://jobsflood.com


# ---------------------------------------------------------------------------
# Two rules the build will enforce for you (core/config/environment.dart)
# ---------------------------------------------------------------------------
#
# 1. OUTSIDE DEVELOPMENT, API_BASE_URL MUST BE https.
#    The server sets Secure on the session cookie whenever DEBUG is off, so over
#    plain http the cookie is never sent -- the session simply does not exist and
#    every screen fails with nothing logged to say why. Env.assertValid() refuses
#    to start rather than ship that, mirroring the server's own refusal to serve
#    with DEBUG=false and COOKIE_SECURE=false.
#
# 2. USE THE APEX, NOT www.
#    www.jobsflood.com has NO DNS A RECORD (blocked on the owner -- see
#    tasks/blocked.md OWNER-004). An app pointed at it fails to resolve, and that
#    failure reads as the phone being offline rather than as a misconfiguration.
#    Env.assertValid() rejects it by name.
